# Names only, never values. Copy to .env for local development.
# In production these live on Cloudflare: secrets on the Worker, and the
# PUBLIC_ variable as a Workers Builds build variable (it is inlined at build time).

# Keystatic GitHub mode (Keystatic writes these when the GitHub App is created)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional, development only: set to "github" to use GitHub mode in `pnpm dev`
# PUBLIC_KEYSTATIC_STORAGE=

# Contact form (brief section 8). Secrets on the Worker; TURNSTILE_SITE_KEY is
# inlined at build time, so it is a Workers Builds build variable.
# For local testing, Cloudflare's dummy keys always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Optional: "Name <address>" on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
