---
import { getSite } from '../lib/site';
import Todo from './Todo.astro';
import NewsletterForm from './NewsletterForm.astro';
import { NEWSLETTER } from '../lib/newsletter';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-soft">
  <div class="container-site grid gap-10 py-12 md:grid-cols-2">
    <div class="space-y-4">
      <p class="font-heading text-lg font-bold text-ink">{site.name}</p>
      <p class="text-muted"><Todo need="short bio line for the footer" blocker /></p>
      <p class="text-muted"><Todo need="social links" blocker /></p>
    </div>

    <section id="newsletter" aria-labelledby="newsletter-heading" class="space-y-3">
      <h2 id="newsletter-heading" class="text-xl">{NEWSLETTER.name}</h2>
      <p class="text-muted">{NEWSLETTER.pitch}</p>
      <NewsletterForm location="footer" />
    </section>
  </div>

  <div class="container-site flex flex-wrap gap-x-6 gap-y-2 border-t border-line py-6 text-sm text-muted">
    <p>© {year} {site.name}</p>
    <a href="/rss.xml">RSS</a>
    <p>Built with <a href="https://astro.build" class="underline">Astro</a></p>
  </div>
</footer>
