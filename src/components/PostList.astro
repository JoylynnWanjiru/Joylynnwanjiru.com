---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/dates';
import { readingTime } from '../lib/reading-time';
import { tagLabel } from '../lib/collections';

interface Props {
  posts: CollectionEntry<'posts'>[];
  /** Shown instead of an empty list (brief: empty states never look broken). */
  empty?: string;
}
const { posts, empty = 'The first posts are on their way.' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="text-muted">{empty}</p>
  ) : (
    <ol class="divide-y divide-line" role="list">
      {posts.map((post) => (
        <li class="py-6">
          <article>
            <h2 class="text-xl">
              <a href={`/writing/${post.id}/`} class="text-ink no-underline hover:text-blue">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-1 text-sm text-muted">
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time> ·{' '}
              {readingTime(post.body ?? '')} min read
            </p>
            <p class="mt-2 text-muted">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2" role="list" aria-label="Tags">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={`/writing/tags/${tag}/`} class="pill">
                      {tagLabel(tag)}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))}
    </ol>
  )
}
