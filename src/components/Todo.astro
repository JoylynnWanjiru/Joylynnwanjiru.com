---
// Visible placeholder for content Joylynn has not provided yet (brief section 0, rule 1).
// `pnpm check:launch` finds these by the TODO(joylynn) text in source.
interface Props {
  need: string;
}
const { need } = Astro.props;
---

<span class="rounded border border-dashed border-pink-text px-1.5 py-0.5 font-code text-sm text-pink-text">
  TODO(joylynn): {need}
</span>
