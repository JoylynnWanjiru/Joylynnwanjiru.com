---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead, { type Props as SEOProps } from '../components/SEOHead.astro';
import '../styles/global.css';

type Props = SEOProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead {...Astro.props} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <!-- Applies the saved theme before first paint (no flash) and marks JS as available. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <!-- Preload only the two fonts used above the fold (brief section 3). -->
    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body class="bg-bg text-ink">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
