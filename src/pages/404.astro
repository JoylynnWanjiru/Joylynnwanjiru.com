---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container-site py-20">
    <p class="font-code text-sm text-pink-text">404</p>
    <h1 class="mt-2 text-4xl">This page doesn't exist.</h1>
    <p class="mt-4 max-w-article text-lg text-muted">It may have moved, or the link may be wrong.</p>
    <ul class="mt-8 flex flex-wrap gap-6">
      <li><a href="/writing/" data-search>Search the site</a></li>
      <li><a href="/start">Start here</a></li>
      <li><a href="/writing">Read the writing</a></li>
      <li><a href="/">Go home</a></li>
    </ul>
  </section>
</BaseLayout>
