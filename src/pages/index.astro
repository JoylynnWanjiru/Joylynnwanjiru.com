---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Todo from '../components/Todo.astro';
import { site } from '../lib/site';

// Phase 1 shell: hero copy is from brief sections 1 and 5; the full home page is built in phase 2.
const posts = await getCollection('posts');
---

<BaseLayout description="I build software people can trust: for public institutions, communities and growing businesses.">
  <section class="hero">
    <div class="container-site py-20 md:py-28">
      <h1 class="text-4xl">Hi, I'm {site.name}.</h1>
      <p class="mt-4 max-w-article text-xl text-ink">
        I build software people can trust: for public institutions, communities and growing businesses.
      </p>
      <p class="mt-3 font-heading text-2xl font-semibold text-pink">{site.signature}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/writing" class="rounded-full bg-blue px-5 py-2.5 font-medium text-on-blue no-underline">Read my writing</a>
        <a href="/work" class="rounded-full border border-line px-5 py-2.5 font-medium text-ink no-underline hover:border-tint-line">See my work</a>
      </div>
      <p class="mt-8"><Todo need="portrait photo" /></p>
    </div>
  </section>

  <section class="container-site py-12">
    <h2 class="text-2xl">Latest writing</h2>
    <ul class="mt-4 space-y-2">
      {posts.map((post) => <li><a href={`/writing/${post.id}`}>{post.data.title}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--glow), var(--wash);
  }
</style>
