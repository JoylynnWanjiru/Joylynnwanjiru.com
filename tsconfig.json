{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // The two config files use Node APIs, whose types (@types/node) are not installed yet.
  "exclude": ["dist", "astro.config.mjs", "vitest.config.ts"],
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./src/assets/*"]
    }
  }
}
